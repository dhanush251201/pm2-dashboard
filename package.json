{
  "name": "pm2-dashboard",
  "version": "0.1.0",
  "private": true,
  "description": "Local web dashboard covering every pm2 operation",
  "workspaces": ["server", "web"],
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,magenta \"npm:dev -w server\" \"npm:dev -w web\"",
    "build": "npm run build -w web",
    "start": "npm start -w server"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
